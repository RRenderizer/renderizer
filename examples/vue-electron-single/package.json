{
  "name": "@renderizer/example-vue-electron-single",
  "version": "1.0.0-beta.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1\" \"npm run build:electron && wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "@renderizer/vue": "^1.0.0-beta.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.0.6",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^43.2.0",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.4",
    "wait-on": "^8.0.3"
  }
}
