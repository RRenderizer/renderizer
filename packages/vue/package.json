{
  "name": "@renderizer/vue",
  "version": "0.1.0-alpha.6",
  "description": "Vue adapter for Renderizer multi-window surfaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "renderizer",
    "vue",
    "teleport",
    "electron",
    "multi-window"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRenderizer/renderizer.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/RRenderizer/renderizer/issues"
  },
  "homepage": "https://github.com/RRenderizer/renderizer#readme",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "peerDependencies": {
    "electron": ">=28",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "dependencies": {
    "@renderizer/core": "^0.1.0-alpha.4"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "typescript": "^5.9.2",
    "vue": "^3.5.18"
  }
}
