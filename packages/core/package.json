{
  "name": "@renderizer/core",
  "version": "0.1.0-alpha.4",
  "description": "Framework-agnostic runtime for lightweight Renderizer window surfaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "renderizer",
    "electron",
    "window-open",
    "multi-window",
    "teleport",
    "portal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRenderizer/renderizer.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/RRenderizer/renderizer/issues"
  },
  "homepage": "https://github.com/RRenderizer/renderizer#readme",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
