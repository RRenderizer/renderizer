{
  "name": "@renderizer/core",
  "version": "0.1.0-alpha.0",
  "description": "Framework-agnostic runtime for lightweight Renderizer window surfaces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "window-open",
    "multi-window",
    "teleport",
    "portal"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
